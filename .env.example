# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# GOLDEX AI - ENVIRONMENT VARIABLES TEMPLATE (MATCHING RAILWAY SCREENSHOT)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Catatan: Salin variabel berikut ke tab "Variables" di Railway Anda.
# Semua variabel opsional sudah memiliki nilai default di dalam kode, sehingga
# Anda HANYA perlu mengisi variabel yang Anda miliki di screenshot Railway Anda!

# 1. Admin Dashboard Credentials (Wajib jika ingin login)
DASHBOARD_USER=admin
DASHBOARD_PASS=nano2026

# 2. Security Session Key (Mengamankan login)
# Bisa diisi string acak apa saja, misal: xauusd-nano-dashboard-2026
SECRET_KEY=xauusd-nano-dashboard-2026

# 3. Market Data Providers (Twelve Data / Broker Bridge)
# Jika memakai Twelve Data, isi API key Anda di sini:
TWELVE_DATA_KEY=
# Jika memakai MT5 Bridge, isi URL & token di sini:
MT5_BRIDGE_URL=
MT5_BRIDGE_TOKEN=

# 4. Telegram Alerts Configuration (Untuk mengirim sinyal ke Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 5. AI Analyst Credentials (Untuk konfirmasi pola & visual chart)
# Kode mendukung Anthropic API Key ataupun Gemini API Key secara otomatis.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# 6. News & Sentiment APIs (Optional)
GNEWS_API_KEY=
MARKETAUX_API_KEY=

# 7. Analysis & Timeframe Configuration (Optional, default is 60s & 1m)
ANALYSIS_INTERVAL_SEC=60
DEFAULT_TIMEFRAME=1m

# 8. Production Persistence Storage (Optional, diisi otomatis oleh Railway)
RAILWAY_VOLUME_MOUNT_PATH=
